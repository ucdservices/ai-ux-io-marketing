      "composition": false,
      "tags": [
        "test-case"
      ]
    },
    {
      "id": "file-horizontal",
      "name": "Horizontal",
      "template": "<div nve-layout=\"column gap:lg align:stretch\">\n  <nve-file layout=\"horizontal\">\n    <label>label</label>\n    <input type=\"file\" />\n    <nve-control-message>message</nve-control-message>\n  </nve-file>\n\n  <nve-file layout=\"horizontal\">\n    <label>disabled</label>\n    <input type=\"file\" disabled />\n    <nve-control-message>message</nve-control-message>\n  </nve-file>\n\n  <nve-file layout=\"horizontal\">\n    <label>success</label>\n    <input type=\"file\" />\n    <nve-control-message status=\"success\">message</nve-control-message>\n  </nve-file>\n\n  <nve-file layout=\"horizontal\">\n    <label>error</label>\n    <input type=\"file\" />\n    <nve-control-message status=\"error\">message</nve-control-message>\n  </nve-file>\n</div>\n",
      "summary": "Horizontal layout file inputs with side-by-side labels. Ideal for compact forms or when aligning labels with other horizontal form controls.",
