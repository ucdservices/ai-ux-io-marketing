      "id": "dropdown-closed-popover-layout",
      "name": "ClosedPopoverLayout",
      "template": "<section id=\"closed-popover-layout\" nve-layout=\"column gap:md\">\n  <p nve-text=\"body\">Measure 120 resize/layout operations with 64 closed menus, first fresh and then after dismissal. Lower times mean less work.</p>\n  <nve-button data-run>Run benchmark</nve-button>\n  <p nve-text=\"body\" role=\"status\">Ready. Each run resets the menus; setup time is excluded.</p>\n  <div data-panel nve-layout=\"column gap:sm pad:sm\" style=\"resize: horizontal; overflow: auto; width: 640px; min-width: 320px; max-width: 100%; height: 360px\">\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-0\">Menu 1</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-0\">Menu 1 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-1\">Menu 2</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-1\">Menu 2 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-2\">Menu 3</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-2\">Menu 3 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-3\">Menu 4</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-3\">Menu 4 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-4\">Menu 5</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-4\">Menu 5 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-5\">Menu 6</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-5\">Menu 6 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-6\">Menu 7</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-6\">Menu 7 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-7\">Menu 8</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-7\">Menu 8 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-8\">Menu 9</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-8\">Menu 9 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-9\">Menu 10</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-9\">Menu 10 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-10\">Menu 11</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-10\">Menu 11 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-11\">Menu 12</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-11\">Menu 12 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-12\">Menu 13</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-12\">Menu 13 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-13\">Menu 14</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-13\">Menu 14 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-14\">Menu 15</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-14\">Menu 15 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-15\">Menu 16</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-15\">Menu 16 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-16\">Menu 17</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-16\">Menu 17 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-17\">Menu 18</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-17\">Menu 18 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-18\">Menu 19</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-18\">Menu 19 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-19\">Menu 20</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-19\">Menu 20 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-20\">Menu 21</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-20\">Menu 21 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-21\">Menu 22</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-21\">Menu 22 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-me