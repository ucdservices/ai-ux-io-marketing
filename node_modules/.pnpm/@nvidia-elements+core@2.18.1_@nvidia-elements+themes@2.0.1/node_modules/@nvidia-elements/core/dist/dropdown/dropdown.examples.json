n id=\"closed-popover-layout-menu-30\">Menu 31 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-31\">Menu 32</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-31\">Menu 32 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-32\">Menu 33</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-32\">Menu 33 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-33\">Menu 34</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-33\">Menu 34 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-34\">Menu 35</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-34\">Menu 35 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-35\">Menu 36</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-35\">Menu 36 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-36\">Menu 37</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-36\">Menu 37 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-37\">Menu 38</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-37\">Menu 38 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-38\">Menu 39</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-38\">Menu 39 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-39\">Menu 40</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-39\">Menu 40 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-40\">Menu 41</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-40\">Menu 41 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-41\">Menu 42</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-41\">Menu 42 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-42\">Menu 43</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-42\">Menu 43 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-43\">Menu 44</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-43\">Menu 44 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-44\">Menu 45</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-44\">Menu 45 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-45\">Menu 46</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-45\">Menu 46 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-46\">Menu 47</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-46\">Menu 47 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-47\">Menu 48</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-47\">Menu 48 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-48\">Menu 49</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-48\">Menu 49 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-49\">Menu 50</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-49\">Menu 50 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-50\">Menu 51</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-50\">Menu 51 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-51\">Menu 52</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-51\">Menu 52 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-52\">Menu 53</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-52\">Menu 53 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-53\">Menu 54</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-53\">Menu 54 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-54\">Menu 55</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-54\">Menu 55 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-55\">Menu 56</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-55\">Menu 56 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-56\">Menu 57</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-56\">Menu 57 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-57\">Menu 58</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-57\">Menu 58 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-58\">Menu 59</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-58\">Menu 59 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-59\">Menu 60</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-59\">Menu 60 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-60\">Menu 61</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-60\">Menu 61 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-61\">Menu 62</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-61\">Menu 62 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-62\">Menu 63</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-62\">Menu 63 content</nve-dropdown>\n    </div>\n\n    <div nve-layout=\"row full:width align:right\">\n      <nve-button popovertarget=\"closed-popover-layout-menu-63\">Menu 64</nve-button>\n      <nve-dropdown id=\"closed-popover-layout-menu-63\">Menu 64 content</nve-dropdown>\n    </div>\n  </div>\n</section>\n<script type=\"module\">\n  const root = document.querySelector(\"#closed-popover-layout\");\n  let panel = root.querySelector(\"[data-panel]\");\n  const template = panel.cloneNode(true);\n  const button = root.querySelector(\"[data-run]\");\n  const status = root.querySelector('[role=\"status\"]');\n\n  function measure() {\n    panel.style.width = \"640px\";\n    panel.getBoundingClientRect();\n    const start = performance.now();\n    for (let iteration = 0; iteration < 120; iteration++) {\n      panel.style.width = (iteration % 2 ? 800 : 480) + \"px\";\n      // Force each width change to finish layout within the measured interval.\n      panel.getBoundingClientRect();\n    }\n    const elapsed = performance.now() - start;\n    return elapsed.toFixed(1) + \" ms (\" + (elapsed / 120).toFixed(2) + \" ms/operation)\";\n  }\n\n  button.addEventListener(\"click\", async () => {\n    button.disabled = true;\n    status.textContent = \"Running both measurements…\";\n    try {\n      const freshPanel = template.cloneNode(true);\n      panel.replaceWith(freshPanel);\n      panel = freshPanel;\n      const menus = Array.from(panel.querySelectorAll(\"nve-dropdown\"));\n      await Promise.all(menus.map((menu) => menu.updateComplete));\n      await new Promise(requestAnimationFrame);\n      const fresh = measure();\n      for (const menu of menus) {\n        menu.showPopover({ source: menu.previousElementSibling });\n        // Flush open layout only during preparation so exit transitions can run.\n        menu.getBoundingClientRect();\n        menu.hidePopover();\n      }\n      await new Promise(requestAnimationFrame);\n      await Promise.allSettled(menus.flatMap((menu) => menu.getAnimations().map((animation) => animation.finished)));\n      const dismissed = measure();\n      status.textContent = \"120 resize/layout operations each. Never opened: \" + fresh + \". After dismissal: \" + dismissed + \".\";\n    } finally {\n      button.disabled = false;\n    }\n  });\n</script>\n",
      "summary": "Closed dropdowns anchored to a resizable panel. Measure repeated layout before and after opening and dismissing every menu.",
      "description": "",
      "composition": false,
      "tags": [
        "test-case",
        "performance"
      ]
    },
